# Configurazione Simulatore Android Multi-Device
# Copia questo file come config.env e modifica i valori secondo le tue esigenze

# Configurazione Docker
DOCKER_COMPOSE_PROJECT_NAME=android_simulator
DOCKER_NETWORK_NAME=android_default

# Configurazione dispositivi Android
ANDROID1_ADB_PORT=5555
ANDROID1_WEB_PORT=8080
ANDROID1_VNC_PORT=5901
ANDROID1_IP=172.20.1.10

ANDROID2_ADB_PORT=5556
ANDROID2_WEB_PORT=8081
ANDROID2_VNC_PORT=5902
ANDROID2_IP=172.20.2.10

ANDROID3_ADB_PORT=5557
ANDROID3_WEB_PORT=8082
ANDROID3_VNC_PORT=5903
ANDROID3_IP=172.20.3.10

# Configurazione pannello di controllo
CONTROL_PANEL_PORT=3000
CONTROL_PANEL_HOST=0.0.0.0

# Configurazione automazione
AUTOMATION_MAX_CONCURRENT=3
AUTOMATION_TIMEOUT=300000
AUTOMATION_LOG_LEVEL=info

# Configurazione performance
CPU_LIMIT=2
MEMORY_LIMIT=2g
GPU_MEMORY=256

# Configurazione rete
NETWORK_BRIDGE_1=android1-br
NETWORK_BRIDGE_2=android2-br
NETWORK_BRIDGE_3=android3-br
NETWORK_SUBNET_1=172.20.1.0/24
NETWORK_SUBNET_2=172.20.2.0/24
NETWORK_SUBNET_3=172.20.3.0/24

# Configurazione log
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
LOG_DIRECTORY=/var/log/android-simulator

# Configurazione backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=daily
BACKUP_RETENTION_DAYS=7
BACKUP_DIRECTORY=/backup/android-simulator

# Configurazione monitoraggio
MONITORING_ENABLED=true
MONITORING_INTERVAL=30
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=85

# Configurazione sicurezza
SECURITY_ENABLED=true
FIREWALL_ENABLED=true
VPN_ENABLED=false
SSL_ENABLED=false

# Configurazione sviluppo
DEBUG_MODE=false
VERBOSE_LOGGING=false
DEVELOPMENT_MODE=false
